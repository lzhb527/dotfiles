# --- Ghostty 配置 (Fish Shell + 透明磨砂)

# --- 基础字体 ---
font-family = "JetBrainsMono Nerd Font"
font-size = 17
font-synthetic-style = false
font-feature = -calt

# --- 外观与颜色 ---
background = "#0a0a0a"
foreground = "#ffffff"
background-opacity = 0.7
background-opacity-cells = true
background-blur = macos-glass-regular
background-blur-radius = 80

# --- 光标与选中样式 ---
cursor-style = block
cursor-style-blink = true
adjust-cursor-thickness = 5
cursor-color = #00ff00
selection-background = #ebcb8c
selection-foreground = #000000

custom-shader = shaders/cursor_warp.glsl
custom-shader = shaders/ripple_cursor.glsl
custom-shader-animation = true

# --- macOS 窗口美化 ---
window-padding-x = 8
window-padding-y = 8
macos-titlebar-style = hidden
macos-option-as-alt = true
window-padding-balance = true
window-step-resize = true

# --- 快捷键映射 (macOS) ---
keybind = super+c=copy_to_clipboard:mixed
keybind = super+v=paste_from_clipboard
keybind = super+a=select_all
keybind = super+n=new_window
keybind = super+t=new_tab
keybind = super+w=close_surface
keybind = super+q=quit

# 缩放与配置
keybind = super+plus=increase_font_size:1
keybind = super+-=decrease_font_size:1
keybind = super+0=reset_font_size
keybind = super+enter=toggle_fullscreen
keybind = super+ctrl+f=toggle_maximize
keybind = super+,=open_config
keybind = super+shift+,=reload_config

# --- 选中/粘贴行为 ---
copy-on-select = clipboard
right-click-action = paste

# --- 终端环境与行为 ---
command = /opt/homebrew/bin/fish
scrollback-limit = 20000000
minimum-contrast = 1.1

# 彻底修复：禁止 shell 集成接管覆盖你的自定义绿光标
shell-integration-features = no-cursor

