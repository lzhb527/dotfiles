~/.config/nvim/
├── init.lua                        # 唯一的核心总入口
├── lazy-lock.json                  # 插件锁版本文件（自动生成）
└── lua/
    ├── configs/                    # 存放所有编辑器自身的“基础行为”配置
    │   ├── base.lua                # 🌟 替代原 base/init.lua，管理行号、缩进、透明背景等
    │   ├── keymaps.lua             # 🌟 集中管理所有通用快捷键、保存、分屏、LSP 导航跳转
    │   ├── filetype.lua            # 🌟 集中管理文件头、光标线智能切换、Dashboard 降噪
    │   └── theme.lua               # neovim 主题 catppuccin
    │
    └── plugins/                    # 存放所有与“插件”相关的代码
        ├── init.lua                # 🌟 纯净的插件清单表（只写插件地址与加载时机）
        └── configs/                # 🌟 每个插件一个文件，一一对应存放具体配置
            ├── treesitter.lua          # nvim-treesitter + ts-install
            ├── cmp.lua                 # nvim-cmp 补全 + LuaSnip
            ├── autopairs.lua           # nvim-autopairs 括号自动补全
            ├── mason.lua               # mason + mason-lspconfig + tool-installer
            ├── lsp.lua                 # pyright / ruff / ansiblels 联动
            ├── venv.lua                # venv-selector 虚拟环境
            ├── neotree.lua             # 文件树
            ├── flash.lua               # 极速跳转
            ├── telescope.lua           # 搜索
            ├── gitsigns.lua            # Git 状态
            ├── aerial.lua              # 代码结构树
            ├── noice.lua               # 命令行美化
            ├── colorizer.lua           # 颜色高亮
            ├── ibl.lua                 # 缩进线
            ├── rainbow.lua             # 彩虹括号
            ├── toggleterm.lua          # 浮动终端
            ├── snacks.lua              # 状态列
            ├── visual-multi.lua        # 多光标
            ├── lualine.lua             # 状态栏
            ├── dashboard.lua           # 启动页
            ├── bufferline.lua          # 多标签顶栏
            ├── whichkey.lua            # 按键提示
            ├── trouble.lua             # 诊断看板
            ├── tiny-inline-diagnostic.lua # 光标行内诊断
            └── conform.lua             # 代码格式化
