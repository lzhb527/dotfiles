[merge]
tool=ultracompare

[mergetool "ultracompare"]
keepBackup=false
trustExitCode=false
prompt=false
cmd=\"/Applications/UltraCompare.app/Contents/MacOS/UltraCompare\" -gitm "$LOCAL" "$REMOTE" "$BASE" "$MERGED" -title1 "LOCAL" -title2 "REMOTE" -ff

[UC]
defdiffmerge=yes
defdiff=yes

[diff]
tool=ultracompare

[difftool "ultracompare"]
keepBackup=false
trustExitCode=false
prompt=false
cmd=\"/Applications/UltraCompare.app/Contents/MacOS/UltraCompare\" -gitdt "$LOCAL" "$REMOTE" "$BASE" "$MERGED" -title1 "LOCAL" -title2 "REMOTE" -ff
[http]
	postBuffer = 524288000
	version = HTTP/1.1
	lowSpeedLimit = 0
	lowSpeedTime = 999999
[core]
    compression = -1
    pager = delta
[interactive]
    # 在交互式暂存（如 git add -p）中启用高亮
    diffFilter = delta --color-only

[delta]
    # 常用功能开启
    side-by-side = true    # 默认开启左右分栏对比
    navigate = true        # 在 diff 中按 n 和 N 可以在不同修改点之间跳转
    line-numbers = true    # 显示代码行号
    
    # 样式与主题
    theme = Monokai Extended # 选用内置的经典高亮主题
    syntax-theme = none # 代码语法高亮主题

    # 自定义差异块的文本样式

    # 整行样式
    minus-style = red italic strike
    plus-style = green bold italic underline

    # 精准字符样式
    minus-emph-style = "#000000" red bold
    plus-emph-style = "#000000" green bold

    minus-non-current-style = red
    plus-non-current-style = green
    zero-style = dim

[init]
	defaultBranch = main
[user]
	name = lzhb527
	email = lzhb527@126.com
